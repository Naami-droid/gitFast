# GitFast Environment Variables
# Copy this file to .env and fill in your values.

# ── Required ─────────────────────────────────────────────────────────────
# Your Groq API key (get one at https://console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# ── Optional (for local PR review mode) ──────────────────────────────────
# GitHub Personal Access Token with repo scope
# GITHUB_TOKEN=ghp_your_token_here

# ── Optional overrides ──────────────────────────────────────────────────
# GITFAST_MODEL=llama-3.1-8b-instant
# GITFAST_API_BASE=https://api.groq.com/openai/v1
# GITFAST_MAX_DIFF_CHARS=12000
